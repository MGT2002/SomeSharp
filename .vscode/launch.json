{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WebApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: WebApi",
      "program": "${workspaceFolder}/ProjectRoot/WebApi/bin/Debug/net8.0/WebApi.dll",
      "args": ["--launch-profile", "https"],
      "cwd": "${workspaceFolder}/ProjectRoot/WebApi",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}