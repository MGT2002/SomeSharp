@page "/"
@inject IGameManager GameManager

<PageTitle>Home</PageTitle>

@if (isDataLoaded)
{
    <GameContainer OnPlayerActionClicked="HandlePlayerAction" PlayerActionOptions="current.PlayerActionOptions">
        <Context>
            @current.CurrentContext
        </Context>
    </GameContainer>
}
else
{
    <div class="loading">Loading...</div>
}

@code {
    private bool isDataLoaded = false;
    private GameStateDTO current = default!;

    protected override async Task OnInitializedAsync()
    {
        await GameManager.StartNewGame();
        current = GameManager.GetCurrentState();
        isDataLoaded = true;
    }

    private void HandlePlayerAction(int actionIndex)
    {
        current = GameManager.GetNextState(actionIndex);
    }
}
