<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".sql" #>
<#

var tables = new List<TableInfo>
{
    new TableInfo("Users", new List<ColumnInfo>
    {
        new ColumnInfo("UserId", "INT", isNullable: false, isPrimaryKey: true, isIdentity: true),
        new ColumnInfo("FirstName", "NVARCHAR(100)", isNullable: false),
        new ColumnInfo("LastName", "NVARCHAR(100)", isNullable: false),
        new ColumnInfo("Email", "NVARCHAR(255)", isNullable: false),
        new ColumnInfo("DateCreated", "DATETIME", isNullable: false, defaultValue: "GETDATE()")
    }),
    new TableInfo("Products", new List<ColumnInfo>
    {
        new ColumnInfo("ProductId", "INT", isNullable: false, isPrimaryKey: true, isIdentity: true),
        new ColumnInfo("ProductName", "NVARCHAR(255)", isNullable: false),
        new ColumnInfo("Description", "NVARCHAR(MAX)"),
        new ColumnInfo("Price", "DECIMAL(10, 2)", isNullable: false),
        new ColumnInfo("StockQuantity", "INT", isNullable: false, defaultValue: "0")
    }),
    new TableInfo("Orders", new List<ColumnInfo>
    {
        new ColumnInfo("OrderId", "INT", isNullable: false, isPrimaryKey: true, isIdentity: true),
        new ColumnInfo("UserId", "INT", isNullable: false), // Foreign Key to Users
        new ColumnInfo("OrderDate", "DATETIME", isNullable: false, defaultValue: "GETDATE()"),
        new ColumnInfo("TotalAmount", "DECIMAL(10, 2)", isNullable: false)
    })
};
#>

 --- SQL Generation Logic ---
<#
    foreach (var table in tables)
    {
#>
-- Create Table: <#= table.Name #>
CREATE TABLE [<#= table.Name #>] (
<#
        // Generate column definitions
        for (int i = 0; i < table.Columns.Count; i++)
        {
            var column = table.Columns[i];
#>    [<#= column.Name #>] <#= column.DataType #><#= column.IsIdentity ? " IDENTITY(1,1)" : "" #><#= column.IsNullable ? "" : " NOT NULL" #><#= !string.IsNullOrEmpty(column.DefaultValue) ? " DEFAULT " + column.DefaultValue : "" #><#= (i < table.Columns.Count - 1 || table.Columns.Any(c => c.IsPrimaryKey)) ? "," : "" #>
<#
        }

        // Generate Primary Key constraint
        var primaryKeys = table.Columns.Where(c => c.IsPrimaryKey).ToList();
        if (primaryKeys.Any())
        {
#>    CONSTRAINT [PK_<#= table.Name #>] PRIMARY KEY CLUSTERED (
<#
            for (int i = 0; i < primaryKeys.Count; i++)
            {
#>        [<#= primaryKeys[i].Name #>]<#= (i < primaryKeys.Count - 1) ? "," : "" #>
<#
            }
#>    )
<#
        }
#>
);
GO

<#
        // Generate Foreign Key constraints (example for Orders table)
        if (table.Name == "Orders")
        {
#>
-- Add Foreign Key for Orders.UserId to Users.UserId
ALTER TABLE [Orders]
ADD CONSTRAINT [FK_Orders_Users] FOREIGN KEY ([UserId])
REFERENCES [Users] ([UserId]);
GO

<#
        }
    }
#>

-- End of SQL generation.

<#+
public class ColumnInfo
{
    public string Name { get; set; }
    public string DataType { get; set; }
    public bool IsNullable { get; set; }
    public bool IsPrimaryKey { get; set; }
    public bool IsIdentity { get; set; } // For auto-incrementing columns
    public string DefaultValue { get; set; }

    public ColumnInfo(string name, string dataType, bool isNullable = true, bool isPrimaryKey = false, bool isIdentity = false, string defaultValue = null)
    {
        Name = name;
        DataType = dataType;
        IsNullable = isNullable;
        IsPrimaryKey = isPrimaryKey;
        IsIdentity = isIdentity;
        DefaultValue = defaultValue;
    }
}

public class TableInfo
{
    public string Name { get; set; }
    public List<ColumnInfo> Columns { get; set; }

    public TableInfo(string name, List<ColumnInfo> columns)
    {
        Name = name;
        Columns = columns;
    }
}
#>